msgstr "Pausar"

#: crates/lyra-downloads-gtk/src/task_row.rs:103
msgid "Resume"
msgstr "Reanudar"

#: crates/lyra-downloads-gtk/src/task_row.rs:104
msgid "Cancel transfer"
msgstr "Cancelar transferencia"

#: crates/lyra-downloads-gtk/src/task_row.rs:105
msgid "Try again"
msgstr "Reintentar"

#: crates/lyra-downloads-gtk/src/task_row.rs:106
#: crates/lyra-downloads-backend/src/notify.rs:74
msgid "Open folder"
msgstr "Abrir carpeta"

#: crates/lyra-downloads-gtk/src/task_row.rs:109
#: crates/lyra-downloads-gtk/src/task_row.rs:113
msgid "More actions"
msgstr "Más acciones"

#: crates/lyra-downloads-gtk/src/task_row.rs:188
msgid "{a} of {b}"
msgstr "{a} de {b}"

#: crates/lyra-downloads-gtk/src/task_row.rs:196
msgid "{a} (unknown size)"
msgstr "{a} (tamaño desconocido)"

#: crates/lyra-downloads-gtk/src/task_row.rs:207
msgid "{n} of {max} connections"
msgstr "{n} de {max} conexiones"

#: crates/lyra-downloads-gtk/src/task_row.rs:215
msgid "{t} remaining"
msgstr "faltan {t}"

#: crates/lyra-downloads-gtk/src/task_row.rs:216
msgid "remaining time unknown"
msgstr "tiempo restante desconocido"

#: crates/lyra-downloads-gtk/src/task_row.rs:234
msgid "SHA-256 matches the supplied value"
msgstr "El SHA-256 coincide con el valor indicado"

#: crates/lyra-downloads-gtk/src/task_row.rs:236
msgid "SHA-256 does not match — file kept; verify the source"
msgstr "El SHA-256 no coincide — archivo conservado; verifica el origen"

#: crates/lyra-downloads-gtk/src/task_row.rs:239
msgid "Not verified"
msgstr "Sin verificar"

#: crates/lyra-downloads-gtk/src/task_row.rs:44
msgid "Queued"
msgstr "En cola"

#: crates/lyra-downloads-gtk/src/task_row.rs:45
msgid "Downloading"
msgstr "Descargando"

#: crates/lyra-downloads-gtk/src/task_row.rs:46
msgid "Paused"
msgstr "En pausa"

#: crates/lyra-downloads-gtk/src/task_row.rs:47
msgid "Verifying SHA-256"
msgstr "Comprobando SHA-256"

#: crates/lyra-downloads-gtk/src/task_row.rs:48
msgid "Finished"
msgstr "Completada"

#: crates/lyra-downloads-gtk/src/task_row.rs:49
msgid "Canceled"
msgstr "Cancelada"

#: crates/lyra-downloads-gtk/src/task_row.rs:50
#: crates/lyra-downloads-gtk/src/window.rs:441
msgid "Error"
msgstr "Error"

#: crates/lyra-downloads-gtk/src/window.rs:137
msgid "Download service unavailable: {e}"
msgstr "Servicio de descargas no disponible: {e}"

#: crates/lyra-downloads-gtk/src/window.rs:151
msgid "Try starting the engine"
msgstr "Intentar iniciar el motor"

#: crates/lyra-downloads-gtk/src/window.rs:171
msgid "Total speed: {v}"
msgstr "Velocidad total: {v}"

#: crates/lyra-downloads-gtk/src/window.rs:175
msgid "{n} downloading"
msgstr "{n} descargando"

#: crates/lyra-downloads-gtk/src/window.rs:177
msgid "{n} queued"
msgstr "{n} en cola"

#: crates/lyra-downloads-gtk/src/window.rs:180
msgid "{n} paused"
msgstr "{n} en pausa"

#: crates/lyra-downloads-gtk/src/window.rs:268
msgid "Details"
msgstr "Detalles"

#: crates/lyra-downloads-gtk/src/window.rs:269
msgid "Try with a new link…"
msgstr "Intentar con un enlace nuevo…"

#: crates/lyra-downloads-gtk/src/window.rs:273
msgid "Move to the front of the queue"
msgstr "Mover al principio de la cola"

#: crates/lyra-downloads-gtk/src/window.rs:276
msgid "Move up in queue"
msgstr "Subir en la cola"

#: crates/lyra-downloads-gtk/src/window.rs:277
msgid "Move down in queue"
msgstr "Bajar en la cola"

#: crates/lyra-downloads-gtk/src/window.rs:282
msgid "{n} connections"
msgstr "{n} conexiones"

#: crates/lyra-downloads-gtk/src/window.rs:288
msgid "Remove from history"
msgstr "Quitar del historial"

#: crates/lyra-downloads-gtk/src/window.rs:289
msgid "Delete file from disk…"
msgstr "Eliminar archivo del disco…"

#: crates/lyra-downloads-gtk/src/window.rs:322
msgid "Removed from history. The file was kept on disk."
msgstr "Quitado del historial. El archivo se conservó en el disco."

#: crates/lyra-downloads-gtk/src/window.rs:351
msgid "Connections changed. The transfer resumed from its previous position."
msgstr ""
"Conexiones modificadas. La transferencia se reanudó desde donde estaba."

#: crates/lyra-downloads-gtk/src/window.rs:354
msgid "Connections changed."
msgstr "Conexiones modificadas."

#: crates/lyra-downloads-gtk/src/window.rs:393
