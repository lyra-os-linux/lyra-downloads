#: crates/lyra-downloads-aria2/src/errors.rs:29
msgid "Timed out while contacting the server."
msgstr "Tempo de espera esgotado ao falar com o servidor."

#: crates/lyra-downloads-aria2/src/errors.rs:31
msgid "Resource not found on the server (for example, HTTP 404)."
msgstr "Recurso não encontrado no servidor (por exemplo, HTTP 404)."

#: crates/lyra-downloads-aria2/src/errors.rs:34
msgid "The server repeatedly responded \"not found\"."
msgstr "O servidor respondeu \"não encontrado\" repetidamente."

#: crates/lyra-downloads-aria2/src/errors.rs:36
msgid "The speed fell below the configured minimum."
msgstr "A velocidade ficou abaixo do mínimo configurado."

#: crates/lyra-downloads-aria2/src/errors.rs:39
msgid "Network problem while downloading."
msgstr "Problema de rede ao baixar."

#: crates/lyra-downloads-aria2/src/errors.rs:41
msgid "The server does not support resuming a partial download."
msgstr "O servidor não aceita retomar a partir do ponto parcial."

#: crates/lyra-downloads-aria2/src/errors.rs:44
msgid "Not enough disk space at the destination."
msgstr "Espaço em disco insuficiente no destino."

#: crates/lyra-downloads-aria2/src/errors.rs:46
msgid "The .aria2 control file does not match the download."
msgstr "O arquivo de controle .aria2 não corresponde ao download."

#: crates/lyra-downloads-aria2/src/errors.rs:49
msgid "Another task is already downloading this file."
msgstr "Este arquivo já está sendo baixado por outra tarefa."

#: crates/lyra-downloads-aria2/src/errors.rs:51
msgid "A file with this name already exists at the destination."
msgstr "Já existe um arquivo com este nome no destino."

#: crates/lyra-downloads-aria2/src/errors.rs:54
msgid "Could not rename the file."
msgstr "Não foi possível renomear o arquivo."

#: crates/lyra-downloads-aria2/src/errors.rs:55
msgid "Could not open the existing partial file."
msgstr "Não foi possível abrir o arquivo parcial existente."

#: crates/lyra-downloads-aria2/src/errors.rs:57
msgid "Could not create the file at the destination (check permissions)."
msgstr "Não foi possível criar o arquivo no destino (verifique permissões)."

#: crates/lyra-downloads-aria2/src/errors.rs:60
msgid "Disk read/write error."
msgstr "Erro de leitura/escrita no disco."

#: crates/lyra-downloads-aria2/src/errors.rs:61
msgid "Could not create the destination folder."
msgstr "Não foi possível criar a pasta de destino."

#: crates/lyra-downloads-aria2/src/errors.rs:62
msgid "Could not resolve the server name (DNS)."
msgstr "Falha ao resolver o nome do servidor (DNS)."

#: crates/lyra-downloads-aria2/src/errors.rs:64
msgid "The server denied access or responded unexpectedly."
msgstr "O servidor recusou o acesso ou respondeu de forma inesperada."

#: crates/lyra-downloads-aria2/src/errors.rs:67
msgid "Too many redirects."
msgstr "Redirecionamentos demais."

#: crates/lyra-downloads-aria2/src/errors.rs:68
msgid "The server requires authentication."
msgstr "O servidor exigiu autenticação."

#: crates/lyra-downloads-aria2/src/errors.rs:70
msgid "Invalid option sent to the engine (internal error)."
msgstr "Opção inválida enviada ao motor (erro interno)."

#: crates/lyra-downloads-aria2/src/errors.rs:74
msgid ""
"The server is temporarily unavailable or overloaded (for example, HTTP "
"429/503)."
msgstr ""
"O servidor está temporariamente indisponível ou sobrecarregado (por exemplo, "
"HTTP 429/503)."

#: crates/lyra-downloads-aria2/src/errors.rs:77
msgid "The engine integrity check failed."
msgstr "A verificação de integridade do motor falhou."

#: crates/lyra-downloads-aria2/src/errors.rs:78
msgid "The download engine reported an error."
msgstr "O motor de download informou um erro."

#: crates/lyra-downloads-backend/src/service.rs:1113
#: crates/lyra-downloads-backend/src/service.rs:1174
msgid "Download finished"
msgstr "Download concluído"

#: crates/lyra-downloads-backend/src/service.rs:1140
msgid "{name} — SHA-256 matches the supplied value"
msgstr "{name} — SHA-256 confere com o valor informado"

#: crates/lyra-downloads-backend/src/service.rs:1148
msgid ""
"{name} — SHA-256 does not match. The file was kept; verify the source of the "
"hash and file."
msgstr ""
"{name} — SHA-256 não confere. O arquivo foi mantido; confira a origem do "
"hash e do arquivo."

#: crates/lyra-downloads-backend/src/service.rs:1153
msgid "Could not read the file to verify SHA-256: {e}"
msgstr "Não foi possível ler o arquivo para verificar o SHA-256: {e}"

#: crates/lyra-downloads-backend/src/service.rs:1161
msgid "Internal verification error: {e}"
msgstr "Falha interna na verificação: {e}"

#: crates/lyra-downloads-backend/src/service.rs:134
msgid ""
"The aria2 engine failed repeatedly. Downloads are stopped; use \"Retry\" or "
"restart Lyra Downloads."
msgstr ""
"O motor aria2 falhou várias vezes seguidas. Os downloads estão parados; use "
"\"Tentar novamente\" ou reinicie o Lyra Downloads."

#: crates/lyra-downloads-backend/src/service.rs:157
msgid "The aria2 download engine is not installed. Install the aria2 package."
msgstr "O motor de downloads aria2 não está instalado. Instale o pacote aria2."

#: crates/lyra-downloads-backend/src/service.rs:161
msgid "The aria2 download engine did not respond in time."
msgstr "O motor de downloads aria2 não respondeu a tempo."

#: crates/lyra-downloads-backend/src/service.rs:163
msgid "Could not start the aria2 download engine: {detail}"
msgstr "Não foi possível iniciar o motor de downloads aria2: {detail}"

#: crates/lyra-downloads-backend/src/service.rs:198
msgid "Task not found."
msgstr "Tarefa não encontrada."

#: crates/lyra-downloads-backend/src/service.rs:234
msgid "The engine rejected the download: {e}"
msgstr "O motor recusou o download: {e}"

#: crates/lyra-downloads-backend/src/service.rs:244
msgid "Engine unavailable: {e}"
msgstr "Motor indisponível: {e}"

#: crates/lyra-downloads-backend/src/service.rs:261
msgid "This handoff was cancelled by the browser."
msgstr "Este repasse foi cancelado pelo navegador."

#: crates/lyra-downloads-backend/src/service.rs:279
#: crates/lyra-downloads-backend/src/service.rs:1191
msgid "Enter a valid http:// or https:// address."
msgstr "Informe um endereço http:// ou https:// válido."

#: crates/lyra-downloads-backend/src/service.rs:286
msgid "The address has no valid server."
msgstr "O endereço não tem um servidor válido."

#: crates/lyra-downloads-backend/src/service.rs:303
#: crates/lyra-downloads-backend/src/service.rs:673
msgid "Invalid connection count (use 1, 4, 8 or 16)."
msgstr "Número de conexões inválido (use 1, 4, 8 ou 16)."

#: crates/lyra-downloads-backend/src/service.rs:316
msgid "The expected SHA-256 must have 64 hexadecimal digits."
msgstr "O SHA-256 esperado deve ter 64 dígitos hexadecimais."

#: crates/lyra-downloads-backend/src/service.rs:353
msgid "Invalid destination folder."
msgstr "Pasta de destino inválida."

#: crates/lyra-downloads-backend/src/service.rs:389
msgid "This task cannot be paused now."
msgstr "Esta tarefa não pode ser pausada agora."

#: crates/lyra-downloads-backend/src/service.rs:410
msgid "Only paused downloads can be resumed."
msgstr "Apenas downloads pausados podem ser retomados."

#: crates/lyra-downloads-backend/src/service.rs:432
msgid "Could not resume: {e}"
msgstr "Não foi possível retomar: {e}"

#: crates/lyra-downloads-backend/src/service.rs:448
msgid "This task has already finished."
msgstr "Esta tarefa já terminou."

#: crates/lyra-downloads-backend/src/service.rs:484
msgid "Could not confirm cancellation with the download engine."
msgstr "Não foi possível confirmar o cancelamento no motor."

#: crates/lyra-downloads-backend/src/service.rs:504
msgid "The download engine has not confirmed cancellation yet."
msgstr "O motor ainda não confirmou o cancelamento."

#: crates/lyra-downloads-backend/src/service.rs:512
msgid ""
"The browser did not receive confirmation in time; the download continued in "
"Firefox."
msgstr ""
"O navegador não recebeu a confirmação a tempo; o download continuou no "
"Firefox."

#: crates/lyra-downloads-backend/src/service.rs:524
msgid "Only failed or cancelled downloads can be retried."
msgstr "Só é possível tentar novamente downloads com erro ou cancelados."

#: crates/lyra-downloads-backend/src/service.rs:562
msgid "Cancel the download before removing it from the list."
msgstr "Cancele o download antes de removê-lo da lista."

#: crates/lyra-downloads-backend/src/service.rs:578
msgid "Cancel the download before deleting the file."
msgstr "Cancele o download antes de excluir o arquivo."

#: crates/lyra-downloads-backend/src/service.rs:585
msgid "Invalid file path; nothing was deleted."
msgstr "Caminho do arquivo inválido; nada foi excluído."

#: crates/lyra-downloads-backend/src/service.rs:597
msgid "Could not delete {path}: {e}"
msgstr "Não foi possível excluir {path}: {e}"

#: crates/lyra-downloads-backend/src/service.rs:607
msgid "The destination is not a regular file; nothing was deleted."
msgstr "O destino não é um arquivo comum; nada foi excluído."

#: crates/lyra-downloads-backend/src/service.rs:631
msgid "Only queued downloads can be reordered."
msgstr "Só é possível reordenar downloads aguardando."

#: crates/lyra-downloads-backend/src/service.rs:680
msgid "Connections cannot be changed for a finished task."
msgstr "Não é possível alterar conexões de uma tarefa encerrada."

#: crates/lyra-downloads-backend/src/service.rs:705
#: crates/lyra-downloads-backend/src/service.rs:717
msgid "The engine rejected the change: {e}"
msgstr "O motor não aceitou a alteração: {e}"

#: crates/lyra-downloads-backend/src/service.rs:75
msgid "Download service error: {detail}"
msgstr "Erro do serviço de downloads: {detail}"

#: crates/lyra-downloads-backend/src/service.rs:765
msgid "Simultaneous downloads must be between 1 and 10."
msgstr "Downloads simultâneos deve estar entre 1 e 10."

#: crates/lyra-downloads-backend/src/service.rs:862
msgid "The aria2 engine stopped responding; restarting."
msgstr "O motor aria2 parou de responder; reiniciando."

#: crates/lyra-downloads-backend/src/service.rs:874
msgid "The destination folder must be an absolute path."
msgstr "A pasta de destino precisa ser um caminho absoluto."

#: crates/lyra-downloads-backend/src/service.rs:880
msgid "The destination folder does not exist: {path}"
msgstr "A pasta de destino não existe: {path}"

#: crates/lyra-downloads-backend/src/service.rs:890
msgid "Invalid destination path."
msgstr "Caminho de destino inválido."

#: crates/lyra-downloads-backend/src/service.rs:896
msgid "No write permission for {path}"
msgstr "Sem permissão de escrita em {path}"

#: crates/lyra-downloads-backend/src/service.rs:915
msgid ""
" The link may have expired, the resource may require a login, or access may "
"be blocked."
msgstr ""
" Pode ser um link expirado, um recurso que exige login ou um bloqueio para "
"este acesso."

#: crates/lyra-downloads-backend/src/service.rs:916
msgid " The file may have been removed or the link may be incorrect."
msgstr " O arquivo pode ter sido removido ou o link estar incorreto."

#: crates/lyra-downloads-backend/src/service.rs:917
msgid ""
" The server requested fewer requests; try later or use fewer connections."
msgstr ""
" O servidor pediu para diminuir o ritmo de requisições; tente mais tarde ou "
"com menos conexões."

#: crates/lyra-downloads-backend/src/service.rs:918
msgid " Server error; this is usually temporary."
msgstr " Erro no servidor; costuma ser temporário."

#: crates/lyra-downloads-gtk/src/backend.rs:13
#: crates/lyra-downloads-gtk/src/backend.rs:41
msgid "Invalid response from the download service: {detail}"
msgstr "Resposta inválida do serviço de downloads: {detail}"

#: crates/lyra-downloads-gtk/src/backend.rs:27
msgid "Internal error while contacting the download service."
msgstr "Falha interna ao falar com o serviço de downloads."

#: crates/lyra-downloads-gtk/src/backend.rs:33
msgid "Download service unavailable: {detail}"
msgstr "Serviço de downloads indisponível: {detail}"

#: crates/lyra-downloads-gtk/src/backend.rs:37
msgid "Could not communicate with the download service: {detail}"
msgstr "Não foi possível falar com o serviço de downloads: {detail}"

#: crates/lyra-downloads-gtk/ui/js/main.js:135
msgid "Removed from history. The file was kept on disk."
msgstr "Removido do histórico. O arquivo foi mantido no disco."

#: crates/lyra-downloads-gtk/ui/js/main.js:137
msgid "Connections changed. The transfer resumed from its previous position."
msgstr ""
"Conexões alteradas. A transferência foi reiniciada a partir do ponto em que "
"estava."

#: crates/lyra-downloads-gtk/ui/js/main.js:137
msgid "Connections changed."
msgstr "Conexões alteradas."

#: crates/lyra-downloads-gtk/ui/js/main.js:143
msgid "Delete file from disk?"
msgstr "Excluir arquivo do disco?"

#: crates/lyra-downloads-gtk/ui/js/main.js:144
msgid ""
"“{name}” and its partial data will be deleted from {dir}, and the item will "
"be removed from the list. This cannot be undone."
msgstr ""
"“{name}” e seus dados parciais serão apagados de {dir} e o item sairá da "
"lista. Isso não pode ser desfeito."

#: crates/lyra-downloads-gtk/ui/js/main.js:145
msgid "Delete file"
msgstr "Excluir arquivo"

#: crates/lyra-downloads-gtk/ui/js/main.js:147
msgid "File deleted."
msgstr "Arquivo excluído."

#: crates/lyra-downloads-gtk/ui/js/main.js:151
#: crates/lyra-downloads-gtk/ui/js/main.js:160
#: crates/lyra-downloads-gtk/ui/js/main.js:508
msgid "Address"
msgstr "Endereço"

#: crates/lyra-downloads-gtk/ui/js/main.js:152
msgid "Create task"
msgstr "Criar tarefa"

#: crates/lyra-downloads-gtk/ui/js/main.js:156
msgid "New task created."
msgstr "Nova tarefa criada."

#: crates/lyra-downloads-gtk/ui/js/main.js:158
msgid "Try with a new link"
msgstr "Tentar com um novo link"

#: crates/lyra-downloads-gtk/ui/js/main.js:159
msgid ""
"A new task will be created. The previous link's partial file will not be "
"reused because its content cannot be confirmed to be the same."
msgstr ""
"Será criada uma nova tarefa. O arquivo parcial do link anterior não é "
"reaproveitado, porque não há como confirmar que é o mesmo conteúdo."

#: crates/lyra-downloads-gtk/ui/js/main.js:161
#: crates/lyra-downloads-gtk/ui/js/main.js:487
#: crates/lyra-downloads-gtk/ui/js/ui.js:347
msgid "Cancel"
msgstr "Cancelar"

#: crates/lyra-downloads-gtk/ui/js/main.js:170
msgid "Pause"
msgstr "Pausar"

#: crates/lyra-downloads-gtk/ui/js/main.js:171
msgid "Resume"
msgstr "Retomar"

#: crates/lyra-downloads-gtk/ui/js/main.js:174
msgid "New link…"
msgstr "Novo link…"

#: crates/lyra-downloads-gtk/ui/js/main.js:175
#: crates/lyra-downloads-gtk/ui/js/main.js:526
msgid "Try again"
msgstr "Tentar novamente"

#: crates/lyra-downloads-gtk/ui/js/main.js:178
#: crates/lyra-downloads-gtk/ui/js/main.js:338
#: crates/lyra-downloads-gtk/ui/js/main.js:525
msgid "Open file"
msgstr "Abrir arquivo"

#: crates/lyra-downloads-gtk/ui/js/main.js:186
msgid "{done} of {total}"
msgstr "{done} de {total}"

#: crates/lyra-downloads-gtk/ui/js/main.js:186
msgid "{done} received"
msgstr "{done} recebidos"

#: crates/lyra-downloads-gtk/ui/js/main.js:192
msgid "{time} left"
msgstr "{time} restantes"

#: crates/lyra-downloads-gtk/ui/js/main.js:192
msgid "remaining time unknown"
msgstr "tempo restante desconhecido"

#: crates/lyra-downloads-gtk/ui/js/main.js:193
msgid "{active} of {requested} connections"
msgstr "{active} de {requested} conexões"

#: crates/lyra-downloads-gtk/ui/js/main.js:197
msgid "Queued · position {n}"
msgstr "Na fila · posição {n}"

#: crates/lyra-downloads-gtk/ui/js/main.js:201
msgid "Paused by the system · resumes automatically"
msgstr "Pausado pelo sistema · retoma sozinho"

#: crates/lyra-downloads-gtk/ui/js/main.js:205
msgid "Checking the SHA-256…"
msgstr "Conferindo o SHA-256…"

#: crates/lyra-downloads-gtk/ui/js/main.js:226
msgid "SHA-256 matches"
msgstr "SHA-256 confere"

#: crates/lyra-downloads-gtk/ui/js/main.js:227
msgid "SHA-256 does not match"
msgstr "SHA-256 não confere"

#: crates/lyra-downloads-gtk/ui/js/main.js:256
msgid "Drag to reorder the queue"
msgstr "Arraste para reordenar a fila"

#: crates/lyra-downloads-gtk/ui/js/main.js:261
#: crates/lyra-downloads-gtk/ui/js/main.js:339
#: crates/lyra-downloads-gtk/ui/js/main.js:524
#: crates/lyra-downloads-backend/src/notify.rs:74
msgid "Open folder"
msgstr "Abrir pasta"

#: crates/lyra-downloads-gtk/ui/js/main.js:262
msgid "Cancel transfer"
msgstr "Cancelar transferência"

#: crates/lyra-downloads-gtk/ui/js/main.js:263
msgid "More actions"
msgstr "Mais ações"

#: crates/lyra-downloads-gtk/ui/js/main.js:337
msgid "Details"
msgstr "Detalhes"

#: crates/lyra-downloads-gtk/ui/js/main.js:340
#: crates/lyra-downloads-gtk/ui/js/main.js:523
msgid "Copy address"
msgstr "Copiar endereço"

#: crates/lyra-downloads-gtk/ui/js/main.js:340
#: crates/lyra-downloads-gtk/ui/js/main.js:523
msgid "Address copied."
msgstr "Endereço copiado."

#: crates/lyra-downloads-gtk/ui/js/main.js:341
msgid "Try with a new link…"
msgstr "Tentar com um novo link…"

#: crates/lyra-downloads-gtk/ui/js/main.js:343
msgid "Move to the front of the queue"
msgstr "Mover para o início da fila"

#: crates/lyra-downloads-gtk/ui/js/main.js:344
msgid "Move up in queue"
msgstr "Subir na fila"

#: crates/lyra-downloads-gtk/ui/js/main.js:345
msgid "Move down in queue"
msgstr "Descer na fila"

#: crates/lyra-downloads-gtk/ui/js/main.js:346
#: crates/lyra-downloads-gtk/ui/js/main.js:512
msgid "Requested connections (maximum)"
msgstr "Conexões solicitadas (máximo)"

#: crates/lyra-downloads-gtk/ui/js/main.js:348
#: crates/lyra-downloads-gtk/ui/js/main.js:826
msgid "Remove from history"
msgstr "Remover do histórico"

#: crates/lyra-downloads-gtk/ui/js/main.js:349
msgid "Delete file from disk…"
msgstr "Excluir arquivo do disco…"

#: crates/lyra-downloads-gtk/ui/js/main.js:35
msgid "In progress"
msgstr "Em andamento"

#: crates/lyra-downloads-gtk/ui/js/main.js:36
#: crates/lyra-downloads-gtk/ui/js/main.js:47
msgid "Completed"
msgstr "Concluídos"

#: crates/lyra-downloads-gtk/ui/js/main.js:367
msgid "https://… (one address per line for several)"
msgstr "https://… (um endereço por linha para vários)"

#: crates/lyra-downloads-gtk/ui/js/main.js:367
#: crates/lyra-downloads-gtk/ui/js/main.js:480
msgid "Address (http:// or https://)"
msgstr "Endereço (http:// ou https://)"

#: crates/lyra-downloads-gtk/ui/js/main.js:37
msgid "Failed"
msgstr "Com erro"

#: crates/lyra-downloads-gtk/ui/js/main.js:371
#: crates/lyra-downloads-gtk/ui/js/main.js:373
msgid "File name"
msgstr "Nome do arquivo"

#: crates/lyra-downloads-gtk/ui/js/main.js:375
#: crates/lyra-downloads-gtk/ui/js/main.js:483
#: crates/lyra-downloads-gtk/ui/js/main.js:509
msgid "Folder"
msgstr "Pasta"

#: crates/lyra-downloads-gtk/ui/js/main.js:376
msgid "Optional"
msgstr "Opcional"

#: crates/lyra-downloads-gtk/ui/js/main.js:376
msgid "Expected SHA-256 (optional)"
msgstr "SHA-256 esperado (opcional)"

#: crates/lyra-downloads-gtk/ui/js/main.js:377
#: crates/lyra-downloads-gtk/ui/js/main.js:439
msgid ""
"Verification only confirms that the file matches the supplied hash; trust "
"depends on where the hash came from."
msgstr ""
"A conferência só indica que o arquivo corresponde ao hash informado; a "
"confiança depende de onde o hash veio."

#: crates/lyra-downloads-gtk/ui/js/main.js:38
msgid "All"
msgstr "Todos"

#: crates/lyra-downloads-gtk/ui/js/main.js:383
#: crates/lyra-downloads-gtk/ui/js/main.js:515
msgid "Expected SHA-256"
msgstr "SHA-256 esperado"

#: crates/lyra-downloads-gtk/ui/js/main.js:384
msgid "Connections"
msgstr "Conexões"

#: crates/lyra-downloads-gtk/ui/js/main.js:384
msgid "Maximum requested from the server; it may accept fewer"
msgstr "Máximo solicitado ao servidor; ele pode aceitar menos"

#: crates/lyra-downloads-gtk/ui/js/main.js:389
msgid "More options: SHA-256 and connections"
msgstr "Mais opções: SHA-256 e conexões"

#: crates/lyra-downloads-gtk/ui/js/main.js:391
#: crates/lyra-downloads-gtk/ui/js/main.js:406
msgid "Download"
msgstr "Baixar"

#: crates/lyra-downloads-gtk/ui/js/main.js:401
msgid "Invalid address: {url}. Use http:// or https://."
msgstr "Endereço inválido: {url}. Use http:// ou https://."

#: crates/lyra-downloads-gtk/ui/js/main.js:402
msgid "{n} addresses, with the same folder and options."
msgstr "{n} endereços, com a mesma pasta e as mesmas opções."

#: crates/lyra-downloads-gtk/ui/js/main.js:403
msgid "Tip: paste with Ctrl+V anywhere in the window, or drag a link here."
msgstr ""
"Dica: cole com Ctrl+V em qualquer lugar da janela, ou arraste um link para "
"cá."

#: crates/lyra-downloads-gtk/ui/js/main.js:406
msgid "Download {n} files"
msgstr "Baixar {n} arquivos"

#: crates/lyra-downloads-gtk/ui/js/main.js:409
msgid "Multiple links"
msgstr "Vários links"

#: crates/lyra-downloads-gtk/ui/js/main.js:409
msgid "Each address becomes a download in the queue."
msgstr "Cada endereço vira um download na fila."

#: crates/lyra-downloads-gtk/ui/js/main.js:418
msgid "Contacting the server…"
msgstr "Consultando o servidor…"

#: crates/lyra-downloads-gtk/ui/js/main.js:423
msgid "Size reported by the server: {s}"
msgstr "Tamanho informado pelo servidor: {s}"

#: crates/lyra-downloads-gtk/ui/js/main.js:423
msgid "The server did not report the size."
msgstr "O servidor não informou o tamanho."

#: crates/lyra-downloads-gtk/ui/js/main.js:427
msgid "One connection only"
msgstr "Só uma conexão"

#: crates/lyra-downloads-gtk/ui/js/main.js:428
msgid ""
